# O build da Vercel passou a usar npm em vez de pnpm (ver installCommand em
# vercel.json). Este projeto tem um conflito real de peer dependency:
#
#   mcp-handler exige @modelcontextprotocol/sdk 1.26.0 exato
#   @google/genai aceita ^1.25.2 e traz 1.29.0
#
# Sem legacy-peer-deps o npm aborta com ERESOLVE. Nao e ideal, e a correcao de
# verdade e alinhar as duas versoes, mas isso e mudanca de dependencia e merece
# ser feita com calma, nao no meio de um deploy travado.
legacy-peer-deps=true
