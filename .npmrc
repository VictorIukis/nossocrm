# O pnpm 10 recente trata "script de instalacao nao aprovado" como ERRO fatal, e
# derrubou seis deploys seguidos com ERR_PNPM_IGNORED_BUILDS. A lista de
# aprovados em package.json (pnpm.onlyBuiltDependencies) nao desarma essa
# checagem sozinha.
#
# Aqui ela volta a ser aviso, que era o comportamento ate pouco tempo atras.
# Os pacotes que de fato precisam compilar continuam declarados em package.json.
strict-dep-builds=false
